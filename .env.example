# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.
#
# D-Wave Leap API token (https://cloud.dwavesys.com/leap/).
DWAVE_API_TOKEN=your-dwave-leap-token-here

# IQM Resonance API token (https://resonance.iqm.tech/), used by backend='iqm'.
IQM_TOKEN=your-iqm-resonance-token-here
